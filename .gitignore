# ─── OS / editor cruft ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/

# ─── Secrets / env ──────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ─── Logs / runtime droppings ───────────────────────────────────────────
*.log
*.pid
*.sock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Node (root + web/) ─────────────────────────────────────────────────
node_modules/
dist/
build/
.vite/
.turbo/
.cache/
.parcel-cache/
.eslintcache
coverage/
*.tsbuildinfo

# Vite local-only env file
web/.env
web/.env.local

# ─── Python (ai-engine/) ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# Virtual envs
.venv/
venv/
env/
ENV/

# ─── ai-engine runtime state ────────────────────────────────────────────
# Per-deployment data: SQLite DB (camera configs, zones, rules) and any
# captured snapshots. Don't ship these — they're machine-local.
ai-engine/data/
ai-engine/data/*.db
ai-engine/data/*.db-journal
ai-engine/data/*.db-wal
ai-engine/data/*.db-shm

# Model weights — downloaded on first run, not in source control.
# yolov8*.pt files land wherever ultralytics is invoked from.
ai-engine/models/*.pt
ai-engine/*.pt
ai-engine/yolo*.pt
*.onnx
*.engine

# ─── MediaMTX runtime ───────────────────────────────────────────────────
recordings/

# ─── Misc ───────────────────────────────────────────────────────────────
.tmp/
tmp/
.vercel/
